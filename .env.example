# All of these are optional for local development.

# Port for the server. Default: 3001
PORT=3001

# Postgres connection string. Leave unset to use the built-in embedded database (PGlite),
# which stores its files in ./data/pglite and needs no installation.
# DATABASE_URL=postgres://user:password@host:5432/dbname

# Secret used to sign session tokens. Set a long random value in any deployed environment.
# JWT_SECRET=change-me
